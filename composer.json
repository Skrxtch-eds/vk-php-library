{
    "name": "danila-evseev/vk-php-library",
    "description": "Typed PHP client for VK messages and users",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {"psr-4": {"VkLibrary\\": "src/"}},
    "autoload-dev": {"psr-4": {"VkLibrary\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text --coverage-html build/coverage --coverage-clover build/coverage.xml",
        "cs": "phpcs",
        "analyse": "phpstan analyse --memory-limit=256M",
        "check": ["@test", "@cs", "@analyse"]
    },
    "config": {"sort-packages": true, "platform": {"php": "8.1.0"}}
}
